<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE html>
<html b:css="false" b:defaultwidgetversion="2" b:layoutsVersion="3" b:responsive="true" b:templateVersion="0.0.0" xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr">
  <head>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <meta content="0.0.0+GOLDEN_SHA_40_CHARS________________" name="theme-build"/>
    <title>
      <b:eval expr="data:view.title.escaped"/>
    </title>
    <b:skin version="0.0.0">
      <![CDATA[
:root{color:oklch(.23 .012 85);background:oklch(.984 .004 85)}body{margin:0;min-height:100vh;font-family:system-ui,sans-serif}main{min-height:1px}
      ]]>
    </b:skin>
  </head>
  <body><a class="skip-link" href="#content">Skip to content</a>
    <header role="banner">
      <b:section id="masthead" maxwidgets="1" name="Masthead" showaddelement="no">
        <b:widget id="Header1" locked="true" title="Blog Header" type="Header" version="2" visible="true">
          <b:includable id="main" var="this">
            <b:if cond="data:view.isHomepage">
              <h1 class="site-title"><a expr:href="data:blog.homepageUrl">
                  <b:eval expr="data:title"/></a></h1>
              <b:else/>
              <p class="site-title"><a expr:href="data:blog.homepageUrl">
                  <b:eval expr="data:title"/></a></p>
            </b:if>
            <b:if cond="data:description">
              <p class="site-tagline">
                <b:eval expr="data:description"/>
              </p>
            </b:if>
          </b:includable>
        </b:widget>
      </b:section>
    </header>
    <main id="content" role="main" tabindex="-1">
      <b:section id="main" maxwidgets="1" name="Posts" preferred="yes" showaddelement="no">
        <b:widget id="Blog1" locked="true" title="Blog Posts" type="Blog" version="2" visible="true">
          <b:widget-settings>
            <b:widget-setting name="showDateHeader">false</b:widget-setting>
            <b:widget-setting name="showAuthor">true</b:widget-setting>
            <b:widget-setting name="showLabels">true</b:widget-setting>
            <b:widget-setting name="showTimestamp">true</b:widget-setting>
            <b:widget-setting name="showCommentLink">true</b:widget-setting>
            <b:widget-setting name="showBacklinks">false</b:widget-setting>
            <b:widget-setting name="showInlineAds">false</b:widget-setting>
            <b:widget-setting name="showShareButtons">false</b:widget-setting>
          </b:widget-settings>
          <b:includable id="main">
            <b:if cond="data:view.isError">
              <b:include name="errorState"/>
              <b:else/>
              <b:if cond="not data:view.isHomepage">
                <b:include name="viewHeading"/>
              </b:if>
              <b:if cond="data:posts.empty">
                <b:include name="status-message"/>
                <b:else/>
                <div class="blog-posts">
                  <b:loop index="i" values="data:posts" var="post">
                    <b:include data="{ post: data:post, index: data:i }" name="post"/>
                  </b:loop>
                </div>
                <b:if cond="data:view.isMultipleItems">
                  <b:include name="postPagination"/>
                </b:if>
              </b:if>
            </b:if>
          </b:includable>
          <b:includable id="viewHeading">
            <b:if cond="data:view.isLabelSearch">
              <h1 class="view-title">Filed under 
                <b:eval expr="data:view.search.label"/>
              </h1>
              <b:elseif cond="data:view.isSearch and not data:view.isLabelSearch"/>
              <h1 class="view-title">Results for 
                <b:eval expr="data:view.search.query"/>
              </h1>
              <b:elseif cond="data:view.isArchive"/>
              <h1 class="view-title">
                <b:eval expr="data:view.archive.rangeMessage"/>
              </h1>
            </b:if>
          </b:includable>
          <b:includable id="post" var="entry">
            <article expr:data-post-id="data:entry.post.id">
              <b:class expr:name="data:view.isHomepage and not data:newerPageUrl and data:entry.index == 0 ? &quot;post-lead&quot; : &quot;post-row&quot;"/>
              <b:include data="data:entry.post" name="postHeader"/>
              <b:if cond="data:view.isSingleItem">
                <b:include data="data:entry.post" name="postBody"/>
                <b:else/>
                <b:include data="data:entry.post" name="postBodySnippet"/>
              </b:if>
              <b:include data="data:entry.post" name="postFooter"/>
              <b:if cond="data:view.isPost">
                <b:include data="data:entry.post" name="postCommentsAndAd"/>
              </b:if>
            </article>
          </b:includable>
          <b:includable id="postHeader" var="post">
            <header class="post-header">
              <b:include data="data:post" name="postTitle"/>
              <b:include data="data:post" name="postMeta"/>
            </header>
          </b:includable>
          <b:includable id="postTitle" var="post">
            <b:if cond="data:view.isSingleItem">
              <h1 class="post-title">
                <b:eval expr="data:post.title"/>
              </h1>
              <b:else/>
              <h2 class="post-title"><a expr:href="data:post.url">
                  <b:eval expr="data:post.title"/></a></h2>
            </b:if>
          </b:includable>
          <b:includable id="postMeta" var="post">
            <p class="post-meta">
              <time expr:datetime="data:post.date.iso8601">
                <b:eval expr="data:post.date"/>
              </time>
              <b:if cond="data:post.author.name"><span class="post-author">
                  <b:eval expr="data:post.author.name"/></span></b:if>
            </p>
          </b:includable>
          <b:includable id="postBody" var="post">
            <div class="article-body"><data:post.body/>
            </div>
          </b:includable>
          <b:includable id="postBodySnippet" var="post">
            <p class="post-snippet">
              <b:eval expr="snippet(data:post.snippets.long, {length: 180, links: false, linebreaks: false, ellipsis: true})"/>
            </p>
          </b:includable>
          <b:includable id="postFooter" var="post">
            <b:if cond="data:view.isPost">
              <footer class="post-footer">
                <div class="share-bar"><a expr:href="data:post.url.canonical">Permalink</a></div>
                <b:include data="data:post" name="postFooterAuthorProfile"/>
                <div class="related"></div>
                <div class="reading-progress"></div>
              </footer>
            </b:if>
          </b:includable>
          <b:includable id="postFooterAuthorProfile" var="post">
            <div class="author-bio">
              <b:if cond="data:post.author.profileUrl"><a class="author-name" expr:href="data:post.author.profileUrl" rel="author">
                  <b:eval expr="data:post.author.name"/></a>
                <b:else/><span class="author-name">
                  <b:eval expr="data:post.author.name"/></span>
              </b:if>
              <b:if cond="data:post.author.aboutMe">
                <p>
                  <b:eval expr="data:post.author.aboutMe"/>
                </p>
              </b:if>
            </div>
          </b:includable>
          <b:includable id="postCommentsAndAd" var="post">
            <b:include data="data:post" name="comments"/>
          </b:includable>
          <b:includable id="comments" var="post">
            <b:if cond="data:post.allowComments">
              <section class="comments">
                <b:include data="data:post" name="commentsTitle"/>
                <b:with value="data:post.comments filter (c =&gt; not data:c.inReplyTo)" var="roots">
                  <b:if cond="data:roots.empty">
                    <p class="comments-empty">No comments yet.</p>
                    <b:else/>
                    <ol class="comment-list">
                      <b:loop values="data:roots" var="root">
                        <b:include data="data:root" name="commentItem"/>
                        <b:with value="data:post.comments filter (c =&gt; data:c.inReplyTo == data:root.id)" var="replies">
                          <b:if cond="not data:replies.empty">
                            <ol class="comment-replies">
                              <b:loop values="data:replies" var="reply">
                                <b:include data="data:reply" name="commentItem"/>
                              </b:loop>
                            </ol>
                          </b:if>
                        </b:with>
                      </b:loop>
                    </ol>
                  </b:if>
                </b:with>
                <b:if cond="data:post.allowNewComments">
                  <b:include data="data:post" name="commentForm"/>
                </b:if>
              </section>
            </b:if>
          </b:includable>
          <b:includable id="commentsTitle" var="post">
            <h2>Comments</h2>
          </b:includable>
          <b:includable id="threadedComments" var="post">
            <b:include data="data:post" name="commentList"/>
          </b:includable>
          <b:includable id="commentList" var="post">
            <ol class="comment-list">
              <b:loop values="data:post.comments" var="comment">
                <b:include data="data:comment" name="commentItem"/>
              </b:loop>
            </ol>
          </b:includable>
          <b:includable id="commentItem" var="comment">
            <li class="comment" expr:data-comment-id="data:comment.id">
              <b:if cond="data:comment.isDeleted">
                <p class="comment-tombstone">Comment deleted.</p>
                <b:else/>
                <p class="comment-author">
                  <b:if cond="data:comment.author">
                    <b:eval expr="data:comment.author"/>
                    <b:else/>Anonymous
                  </b:if>
                </p>
                <div class="comment-body">
                  <b:eval expr="data:comment.body"/>
                </div>
                <time expr:datetime="data:comment.timestampValue">
                  <b:eval expr="data:comment.timestamp"/>
                </time>
              </b:if>
            </li>
          </b:includable>
          <b:includable id="commentForm" var="post">
            <div class="comment-form">
              <b:include data="data:post" name="commentFormIframeSrc"/>
            </div>
          </b:includable>
          <b:includable id="commentFormIframeSrc" var="post">
            <b:if cond="data:post.commentFormIframeSrc">
              <iframe expr:src="data:post.commentFormIframeSrc" title="Comment form"/>
            </b:if>
          </b:includable>
          <b:includable id="postPagination">
            <b:if cond="data:newerPageUrl or data:olderPageUrl">
              <nav class="blog-pager" aria-label="Posts">
                <b:if cond="data:newerPageUrl">
                  <b:include name="previousPageLink"/>
                </b:if>
                <b:if cond="data:olderPageUrl">
                  <b:include name="nextPageLink"/>
                </b:if>
              </nav>
            </b:if>
          </b:includable>
          <b:includable id="previousPageLink"><a class="blog-pager-newer-link" expr:href="data:newerPageUrl">Newer</a></b:includable>
          <b:includable id="nextPageLink"><a class="blog-pager-older-link" expr:href="data:olderPageUrl">Older</a></b:includable>
          <b:includable id="homePageLink"><a expr:href="data:blog.homepageUrl">All posts</a></b:includable>
          <b:includable id="recentList" var="posts">
            <ul class="recent-posts">
              <b:loop index="i" values="data:posts" var="recent">
                <b:if cond="data:i &lt; 5">
                  <li><a expr:href="data:recent.url">
                      <b:eval expr="data:recent.title"/></a></li>
                </b:if>
              </b:loop>
            </ul>
          </b:includable>
          <b:includable id="status-message">
            <div class="empty-state" role="status">
              <b:if cond="data:view.isSearch and not data:view.isLabelSearch">
                <p>Nothing matched “
                  <b:eval expr="data:view.search.query"/>”.
                </p>
                <form expr:action="data:blog.searchUrl" role="search">
                  <label for="empty-search">Search</label>
                  <input id="empty-search" expr:value="data:view.search.query.escaped" name="q" type="search"/>
                  <button type="submit">Search</button>
                </form>
                <b:include data="data:widgets.Blog.first.posts" name="recentList"/>
                <b:elseif cond="data:view.isLabelSearch"/>
                <p>Nothing filed under “
                  <b:eval expr="data:view.search.label"/>” yet.
                </p>
                <b:elseif cond="data:view.isArchive"/>
                <p>
                  <b:eval expr="data:view.archive.rangeMessage"/> has no posts.
                </p>
                <b:else/>
                <p>No posts published yet.</p>
              </b:if>
              <b:include name="homePageLink"/>
            </div>
          </b:includable>
          <b:includable id="errorState">
            <section class="empty-state">
              <h1>That page doesn’t exist.</h1>
              <p>Search the journal or return to all posts.</p>
              <form expr:action="data:blog.searchUrl" role="search">
                <label for="error-search">Search</label>
                <input id="error-search" name="q" type="search"/>
                <button type="submit">Search</button>
              </form>
              <b:include data="data:widgets.Blog.first.posts" name="recentList"/>
              <b:include name="homePageLink"/>
            </section>
          </b:includable>
          <b:includable id="postCommentsLink" var="post"><a expr:href="data:post.commentsUrl">
              <b:eval expr="data:post.numberOfComments"/></a></b:includable>
          <b:includable id="postJumpLink"/>
          <b:includable id="feedLinks"/>
          <b:includable id="feedLinksBody"/>
          <b:includable id="inlineAd"/>
          <b:includable id="commentAuthorAvatar"/>
          <b:includable id="commentDeleteIcon"/>
          <b:includable id="commentPicker"/>
          <b:includable id="threadedCommentForm"/>
          <b:includable id="threadedCommentJs"/>
          <b:includable id="addComments"/>
          <b:includable id="aboutPostAuthor"/>
        </b:widget>
      </b:section>
    </main>
    <script>(()=>{document.documentElement.classList.add("js");})();</script>
  </body>
</html>
