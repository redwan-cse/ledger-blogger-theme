<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE html>
<html b:css="false" b:defaultwidgetversion="2" b:layoutsVersion="3" b:responsive="true" b:templateVersion="0.0.0" expr:dir="data:blog.languageDirection" expr:lang="data:blog.locale.language" xmlns="http://www.w3.org/1999/xhtml" xmlns:b="http://www.google.com/2005/gml/b" xmlns:data="http://www.google.com/2005/gml/data" xmlns:expr="http://www.google.com/2005/gml/expr">
  <head>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <meta content="0.0.0+GOLDEN_SHA_40_CHARS________________" name="theme-build"/>
    <title>
      <b:eval expr="data:view.title.escaped"/>
    </title>
    <b:include data="blog" name="all-head-content"/>
    <b:skin version="0.0.0">
      <![CDATA[
:root{color:oklch(.23 .012 85);background:oklch(.984 .004 85)}body{margin:0;min-height:100vh;font-family:system-ui,sans-serif}main{min-height:1px}
      ]]>
    </b:skin>
  </head>
  <body><a class="skip-link" href="#content">Skip to content</a>
    <div class="header-outer">
      <b:section class="header" id="header" maxwidgets="1" name="Header" showaddelement="no">
        <b:widget id="Header1" locked="true" title="Blog Header" type="Header" version="2" visible="true">
          <b:includable id="main" var="this">
            <b:if cond="data:view.isHomepage">
              <h1 class="site-title"><a expr:href="data:blog.homepageUrl">
                  <b:eval expr="data:title"/></a></h1>
              <b:else/>
              <p class="site-title"><a expr:href="data:blog.homepageUrl">
                  <b:eval expr="data:title"/></a></p>
            </b:if>
            <b:if cond="data:description">
              <p class="site-tagline">
                <b:eval expr="data:description"/>
              </p>
            </b:if>
          </b:includable>
        </b:widget>
      </b:section>
    </div>
    <main class="main-content" id="content" role="main">
      <b:section class="main" id="pageBody" name="Page Body" showaddelement="no">
        <b:widget id="Blog1" locked="true" title="Blog Posts" type="Blog" version="2" visible="true">
          <b:includable id="main">
            <b:include name="super.main"/>
          </b:includable>
          <b:includable id="post" var="post">
            <article class="post" itemprop="blogPost" itemscope="itemscope" itemtype="http://schema.org/BlogPosting">
              <b:include name="postHeader" data="post"/>
              <b:include name="postTitle" data="post"/>
              <b:include name="postBody" data="post"/>
              <b:include name="postFooter" data="post"/>
            </article>
          </b:includable>
          <b:includable id="postTitle" var="post">
            <b:if cond="data:view.isPost or data:view.isPage">
              <h1 class="post-title" itemprop="name headline">
                <b:eval expr="data:post.title"/>
              </h1>
              <b:else/>
              <h2 class="post-title" itemprop="name headline"><a expr:href="data:post.url" itemprop="url">
                  <b:eval expr="data:post.title"/></a></h2>
            </b:if>
          </b:includable>
          <b:includable id="postHeader" var="post">
            <header class="post-header">
              <b:if cond="data:post.date">
                <time class="post-date" expr:datetime="data:post.date.iso8601" itemprop="datePublished">
                  <b:eval expr="data:post.date"/>
                </time>
              </b:if>
            </header>
          </b:includable>
          <b:includable id="postBody" var="post">
            <div class="post-body" itemprop="articleBody">
              <b:eval expr="data:post.body"/>
            </div>
          </b:includable>
          <b:includable id="postFooter" var="post">
            <footer class="post-footer">
              <b:if cond="data:post.labels">
                <div class="post-labels">
                  <b:loop values="data:post.labels" var="label"><a class="label-link" expr:href="data:label.url" rel="tag">
                      <b:eval expr="data:label.name"/></a></b:loop>
                </div>
              </b:if>
            </footer>
          </b:includable>
          <b:includable id="comments" var="post">
            <section class="comments-section" id="comments">
              <b:if cond="data:post.allowComments">
                <b:if cond="data:post.numberOfComments &gt; 0">
                  <h3 class="comments-title">
                    <b:eval expr="data:post.numberOfComments"/> Comments
                  </h3>
                </b:if>
                <b:include name="threadedComments" data="post"/>
                <b:else/>
                <b:if cond="data:post.numberOfComments &gt; 0">
                  <h3 class="comments-title">Comments are closed.</h3>
                </b:if>
              </b:if>
            </section>
          </b:includable>
          <b:includable id="threadedComments" var="post">
            <div class="comments-content">
              <b:if cond="data:post.comments">
                <b:loop values="data:post.comments" var="comment">
                  <div class="comment" expr:id="&quot;c&quot; + data:comment.id">
                    <b:eval expr="data:comment.body"/>
                    <div class="comment-meta">
                      <b:eval expr="data:comment.author"/> · 
                      <b:eval expr="data:comment.timestamp"/>
                    </div>
                  </div>
                </b:loop>
              </b:if>
            </div>
            <b:if cond="data:post.allowComments">
              <b:include name="threadedCommentForm" data="post"/>
            </b:if>
          </b:includable>
          <b:includable id="threadedCommentForm" var="post">
            <div class="comment-form">
              <p>Please leave a comment:</p><a expr:href="data:post.commentFormIframeSrc" id="comment-editor-src">Add Comment</a>
            </div>
          </b:includable>
          <b:includable id="status-message">
            <b:if cond="data:navMessage">
              <div class="status-message">
                <b:eval expr="data:navMessage"/>
              </div>
            </b:if>
          </b:includable>
          <b:includable id="postPagination">
            <div class="pagination">
              <b:if cond="data:newerPageUrl"><a class="newer-link" expr:href="data:newerPageUrl">Newer Posts</a></b:if>
              <b:if cond="data:olderPageUrl"><a class="older-link" expr:href="data:olderPageUrl">Older Posts</a></b:if>
            </div>
          </b:includable>
        </b:widget>
      </b:section>
    </main>
    <script>(()=>{document.documentElement.classList.add("js");})();</script>
  </body>
</html>
