    </b:skin>
    <b:defaultmarkups>
      <b:defaultmarkup type="Common">
        <b:includable id="widgetTitle">
          <b:if cond="data:widget.title">
            <h2 class="widget-title">
              <b:eval expr="data:widget.title"/>
            </h2>
          </b:if>
        </b:includable>
        <b:includable id="widget-title">
          <b:include name="widgetTitle"/>
        </b:includable>
        <b:includable id="widgetNotAvailableInPreview">
          <div class="widget-preview-placeholder">
            <p>
              <b:eval expr="data:widget.title"/>
            </p>
          </div>
        </b:includable>
      </b:defaultmarkup>
      <b:defaultmarkup type="PopularPosts">
        <b:includable id="main" var="this">
          <div class="widget-content popular-posts-content">
            <b:include name="widgetTitle"/>
            <b:if cond="data:posts">
              <ul class="popular-posts-list">
                <b:loop values="data:posts" var="post">
                  <li class="popular-post-item">
                    <b:include data="post" name="snippetedPostContent"/>
                  </li>
                </b:loop>
              </ul>
            </b:if>
            <b:if cond="not data:posts">
              <p class="empty-popular-posts">
                <b:eval expr="data:messages.noPosts"/>
              </p>
            </b:if>
          </div>
        </b:includable>
        <b:includable id="snippetedPostContent" var="post">
          <article class="popular-post-entry">
            <b:include data="post" name="snippetedPostThumbnail"/>
            <div class="popular-post-body">
              <b:include data="post" name="snippetedPostTitle"/>
              <b:include data="post" name="postSnippet"/>
            </div>
          </article>
        </b:includable>
        <b:includable id="snippetedPostTitle" var="post">
          <h3 class="popular-post-title"><a expr:href="data:post.url">
              <b:eval expr="data:post.title"/></a></h3>
        </b:includable>
        <b:includable id="snippetedPostThumbnail" var="post">
          <b:if cond="data:post.featuredImage and data:post.featuredImage.isResizable">
            <b:with value="resizeImage(data:post.featuredImage, 128, &quot;1:1&quot;)" var="thumbUrl"><a class="popular-post-thumbnail-link" expr:href="data:post.url"><img class="popular-post-thumbnail" alt="" expr:src="data:thumbUrl" height="64" loading="lazy" width="64"/></a></b:with>
          </b:if>
        </b:includable>
        <b:includable id="postSnippet" var="post">
          <b:if cond="data:post.snippets.short">
            <p class="popular-post-snippet">
              <b:eval expr="snippet(data:post.snippets.short, {length: 100})"/>
            </p>
          </b:if>
        </b:includable>
      </b:defaultmarkup>
      <b:defaultmarkup type="FeaturedPost">
        <b:includable id="main" var="this">
          <div class="widget-content featured-post-content">
            <b:include name="widgetTitle"/>
            <b:if cond="data:post">
              <b:include data="post" name="snippetedPostContent"/>
            </b:if>
            <b:if cond="not data:post">
              <p class="empty-featured-post">
                <b:eval expr="data:messages.noPosts"/>
              </p>
            </b:if>
          </div>
        </b:includable>
        <b:includable id="snippetedPostContent" var="post">
          <article class="featured-post-card">
            <b:include data="post" name="snippetedPostThumbnail"/>
            <div class="featured-post-body">
              <b:include data="post" name="snippetedPostTitle"/>
              <b:if cond="data:post.snippets.short">
                <p class="featured-post-snippet">
                  <b:eval expr="snippet(data:post.snippets.short, {length: 160})"/>
                </p>
              </b:if>
            </div>
          </article>
        </b:includable>
        <b:includable id="snippetedPostTitle" var="post">
          <h3 class="featured-post-title"><a expr:href="data:post.url">
              <b:eval expr="data:post.title"/></a></h3>
        </b:includable>
        <b:includable id="snippetedPostThumbnail" var="post">
          <b:if cond="data:post.featuredImage and data:post.featuredImage.isResizable">
            <b:with value="resizeImage(data:post.featuredImage, 800, &quot;16:9&quot;)" var="heroImg"><a class="featured-post-thumbnail-link" expr:href="data:post.url"><img class="featured-post-thumbnail" alt="" expr:src="data:heroImg" loading="lazy"/></a></b:with>
          </b:if>
        </b:includable>
      </b:defaultmarkup>
      <b:defaultmarkup type="ContactForm">
        <b:includable id="main" var="this">
          <div class="widget-content contact-form-widget">
            <b:include name="widgetTitle"/>
            <b:include name="formContent"/>
          </div>
        </b:includable>
        <b:includable id="formContent">
          <form class="contact-form" name="contact-form">
            <div class="contact-form-group">
              <label class="contact-form-label" expr:for="data:widget.instanceId + &quot;_contact-form-name&quot;">
                <b:eval expr="data:messages.name"/>
              </label>
              <input class="contact-form-name" expr:id="data:widget.instanceId + &quot;_contact-form-name&quot;" name="name" type="text" value=""/>
            </div>
            <div class="contact-form-group">
              <label class="contact-form-label" expr:for="data:widget.instanceId + &quot;_contact-form-email&quot;">
                <b:eval expr="data:messages.email"/>
              </label>
              <input class="contact-form-email" expr:id="data:widget.instanceId + &quot;_contact-form-email&quot;" name="email" type="email" value=""/>
            </div>
            <div class="contact-form-group">
              <label class="contact-form-label" expr:for="data:widget.instanceId + &quot;_contact-form-email-message&quot;">
                <b:eval expr="data:messages.message"/>
              </label>
              <textarea class="contact-form-email-message" cols="25" expr:id="data:widget.instanceId + &quot;_contact-form-email-message&quot;" name="email-message" rows="5"></textarea>
            </div>
            <input class="contact-form-button contact-form-button-submit" expr:id="data:widget.instanceId + &quot;_contact-form-submit&quot;" expr:value="data:messages.send" type="button"/>
            <div class="contact-form-status">
              <p class="contact-form-error-message" expr:id="data:widget.instanceId + &quot;_contact-form-error-message&quot;"></p>
              <p class="contact-form-success-message" expr:id="data:widget.instanceId + &quot;_contact-form-success-message&quot;"></p>
            </div>
          </form>
        </b:includable>
      </b:defaultmarkup>
      <b:defaultmarkup type="BlogArchive">
        <b:includable id="main" var="this">
          <div class="widget-content blog-archive-content">
            <b:include name="widgetTitle"/>
            <b:if cond="data:this.data">
              <details class="blog-archive-details">
                <b:attr cond="data:view.isArchive" name="open" value="open"/>
                <summary class="blog-archive-summary">
                  <b:eval expr="data:messages.archive"/>
                </summary>
                <b:include name="content"/>
              </details>
            </b:if>
            <b:if cond="not data:this.data">
              <p class="empty-blog-archive">
                <b:eval expr="data:messages.noPosts"/>
              </p>
            </b:if>
          </div>
        </b:includable>
        <b:includable id="content">
          <b:if cond="data:this.style == &quot;FLAT&quot;">
            <b:include name="flat"/>
          </b:if>
          <b:if cond="data:this.style != &quot;FLAT&quot;">
            <b:include name="hierarchy"/>
          </b:if>
        </b:includable>
        <b:includable id="flat">
          <ul class="blog-archive-list">
            <b:loop values="data:this.data" var="interval">
              <li class="blog-archive-item"><a class="blog-archive-link" expr:href="data:interval.url">
                  <b:eval expr="data:interval.name"/></a><span class="blog-archive-count">
                  <b:eval expr="data:interval.post-count"/></span></li>
            </b:loop>
          </ul>
        </b:includable>
        <b:includable id="hierarchy">
          <ul class="blog-archive-tree">
            <b:loop values="data:this.data" var="interval">
              <li class="blog-archive-node">
                <b:include data="interval" name="interval"/>
              </li>
            </b:loop>
          </ul>
        </b:includable>
        <b:includable id="interval" var="interval"><a class="blog-archive-interval-link" expr:href="data:interval.url">
            <b:eval expr="data:interval.name"/></a>
          <b:if cond="data:interval.data">
            <ul class="blog-archive-sublist">
              <b:loop values="data:interval.data" var="subInterval">
                <li class="blog-archive-subitem">
                  <b:include data="subInterval" name="interval"/>
                </li>
              </b:loop>
            </ul>
          </b:if>
        </b:includable>
      </b:defaultmarkup>
      <b:defaultmarkup type="Label">
        <b:includable id="main" var="this">
          <div class="widget-content label-widget-content">
            <b:include name="widgetTitle"/>
            <b:if cond="data:labels">
              <b:include name="content"/>
            </b:if>
            <b:if cond="not data:labels">
              <p class="empty-labels">
                <b:eval expr="data:messages.noLabels"/>
              </p>
            </b:if>
          </div>
        </b:includable>
        <b:includable id="content">
          <b:if cond="data:this.display == &quot;list&quot;">
            <b:include name="list"/>
          </b:if>
          <b:if cond="data:this.display != &quot;list&quot;">
            <b:include name="cloud"/>
          </b:if>
        </b:includable>
        <b:includable id="list">
          <ul class="label-list">
            <b:loop values="data:labels" var="label">
              <li class="label-item"><a class="label-link" expr:href="data:label.url" rel="tag">
                  <b:eval expr="data:label.name"/></a>
                <b:if cond="data:this.showFreqNumbers"><span class="label-count">
                    <b:eval expr="data:label.count"/></span></b:if>
              </li>
            </b:loop>
          </ul>
        </b:includable>
        <b:includable id="cloud">
          <nav class="topics-cloud" aria-label="Topics">
            <b:loop values="data:labels" var="label"><a class="topic-pill" expr:href="data:label.url" rel="tag"><span class="topic-name">
                  <b:eval expr="data:label.name"/></span>
                <b:if cond="data:this.showFreqNumbers"><span class="topic-count">
                    <b:eval expr="data:label.count"/></span></b:if></a></b:loop>
          </nav>
        </b:includable>
      </b:defaultmarkup>
    </b:defaultmarkups>
  </head>
  <body>
    <b:class cond="data:view.isHomepage and not data:newerPageUrl" name="is-home-lead"/>
    <b:class cond="data:view.isPost" name="is-post"/>
    <b:class cond="data:view.isPage" name="is-page"/><a class="skip-link" href="#content">Skip to content</a>
    <div class="header-outer" role="banner">
      <b:section class="header" id="header" maxwidgets="1" name="Header" showaddelement="no">
        <b:widget id="Header1" locked="true" title="Blog Header" type="Header" version="2" visible="true">
          <b:includable id="main">
            <b:with value="data:title ?: data:blog.title" var="headerTitle">
              <b:with value="data:description ?: data:blog.description" var="headerDescription">
                <b:if cond="not data:view.isSingleItem">
                  <h1 class="site-title"><a expr:href="data:blog.homepageUrl">
                      <b:eval expr="data:headerTitle"/></a></h1>
                </b:if>
                <b:if cond="data:view.isSingleItem">
                  <p class="site-title"><a expr:href="data:blog.homepageUrl">
                      <b:eval expr="data:headerTitle"/></a></p>
                </b:if>
                <b:if cond="data:headerDescription">
                  <p class="site-tagline">
                    <b:eval expr="data:headerDescription"/>
                  </p>
                </b:if>
              </b:with>
            </b:with>
          </b:includable>
        </b:widget>
      </b:section>
    </div>
    <b:if cond="data:view.isLayoutMode or data:widgets any (w =&gt; w.sectionId == &quot;navlinks&quot;)">
      <div class="nav-container">
        <b:section class="navlinks" id="navlinks" maxwidgets="1" name="Navigation" showaddelement="no">
          <b:widget id="LinkList1" locked="false" title="Navigation" type="LinkList" version="2" visible="true">
            <b:includable id="main">
              <b:if cond="data:links">
                <nav class="site-nav" aria-label="Main Navigation">
                  <ul class="nav-list">
                    <b:loop values="data:links" var="link">
                      <li class="nav-item"><a class="nav-link" expr:href="data:link.target">
                          <b:eval expr="data:link.name"/></a></li>
                    </b:loop>
                  </ul>
                </nav>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </div>
    </b:if>
    <b:if cond="data:view.isLayoutMode or data:widgets any (w =&gt; w.sectionId == &quot;intro&quot;)">
      <div class="intro-container">
        <b:section class="intro" id="intro" maxwidgets="1" name="Intro" showaddelement="no">
          <b:widget id="HTML1" locked="false" title="Intro" type="HTML" version="2" visible="true">
            <b:includable id="main">
              <b:if cond="data:content">
                <div class="intro-content">
                  <b:eval expr="data:content"/>
                </div>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </div>
    </b:if>
    <b:if cond="data:view.isLayoutMode or data:widgets any (w =&gt; w.sectionId == &quot;topics&quot;)">
      <div class="topics-container">
        <b:section class="topics" id="topics" maxwidgets="1" name="Topics" showaddelement="no">
          <b:widget id="Label1" locked="false" title="Topics" type="Label" version="2" visible="true">
            <b:includable id="main">
              <b:if cond="data:labels">
                <nav class="topics-bar" aria-label="Topic Navigation">
                  <ul class="topics-list">
                    <b:loop values="data:labels" var="label">
                      <li class="topic-item"><a class="topic-pill" expr:href="data:label.url" rel="tag">
                          <b:eval expr="data:label.name"/></a></li>
                    </b:loop>
                  </ul>
                </nav>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </div>
    </b:if>
    <main class="main-content" id="content" role="main">
      <b:section class="main" id="page_body" maxwidgets="1" name="Page Body" showaddelement="no">
        <b:widget id="Blog1" locked="true" preferred="yes" title="Blog Posts" type="Blog" version="2" visible="true">
          <b:widget-settings>
            <b:widget-setting name="showDateHeader">false</b:widget-setting>
            <b:widget-setting name="showAuthor">true</b:widget-setting>
            <b:widget-setting name="showLabels">true</b:widget-setting>
            <b:widget-setting name="showTimestamp">true</b:widget-setting>
            <b:widget-setting name="showCommentLink">true</b:widget-setting>
            <b:widget-setting name="showBacklinks">false</b:widget-setting>
            <b:widget-setting name="showInlineAds">false</b:widget-setting>
            <b:widget-setting name="showShareButtons">false</b:widget-setting>
          </b:widget-settings>
          <b:includable id="main">
            <b:if cond="data:view.isError">
              <b:include name="status-message"/>
            </b:if>
            <b:if cond="data:view.isMultipleItems">
              <b:if cond="not data:posts">
                <b:include name="status-message"/>
              </b:if>
              <b:if cond="data:posts">
                <b:loop values="data:posts" var="post">
                  <b:include data="post" name="post"/>
                </b:loop>
                <b:include name="postPagination"/>
              </b:if>
            </b:if>
            <b:if cond="data:view.isSingleItem">
              <b:if cond="not data:posts">
                <b:include name="status-message"/>
              </b:if>
              <b:if cond="data:posts">
                <b:loop values="data:posts" var="post">
                  <b:include data="post" name="post"/>
                  <b:if cond="data:view.isPost">
                    <b:include data="post" name="comments"/>
                  </b:if>
                </b:loop>
              </b:if>
            </b:if>
          </b:includable>
          <b:includable id="post" var="post">
            <article class="post" itemprop="blogPost" itemscope="itemscope" itemtype="http://schema.org/BlogPosting">
              <b:include name="postHeader" data="post"/>
              <b:include name="postTitle" data="post"/>
              <b:if cond="data:view.isSingleItem">
                <b:include name="postBody" data="post"/>
              </b:if>
              <b:if cond="not data:view.isSingleItem">
                <b:include name="postBodySnippet" data="post"/>
              </b:if>
              <b:include name="postFooter" data="post"/>
            </article>
          </b:includable>
          <b:includable id="postTitle" var="post">
            <b:if cond="data:view.isSingleItem">
              <h1 class="post-title" itemprop="name headline">
                <b:eval expr="data:post.title"/>
              </h1>
            </b:if>
            <b:if cond="not data:view.isSingleItem">
              <h2 class="post-title" itemprop="name headline"><a expr:href="data:post.url" itemprop="url">
                  <b:eval expr="data:post.title"/></a></h2>
            </b:if>
          </b:includable>
          <b:includable id="postHeader" var="post">
            <b:if cond="data:post.date">
              <header class="post-header">
                <time class="post-date" expr:datetime="data:post.date.iso8601" itemprop="datePublished">
                  <b:eval expr="data:post.date"/>
                </time>
              </header>
            </b:if>
          </b:includable>
          <b:includable id="postBody" var="post">
            <div class="post-body" itemprop="articleBody">
              <b:eval expr="data:post.body"/>
            </div>
          </b:includable>
          <b:includable id="postBodySnippet" var="post">
            <div class="post-excerpt" itemprop="description">
              <b:eval expr="snippet(data:post.snippets.long, {length: 180})"/>
            </div>
          </b:includable>
          <b:includable id="postFooter" var="post">
            <b:if cond="data:post.labels">
              <footer class="post-footer">
                <div class="post-labels">
                  <b:loop values="data:post.labels" var="label"><a class="label-link" expr:href="data:label.url" rel="tag">
                      <b:eval expr="data:label.name"/></a></b:loop>
                </div>
              </footer>
            </b:if>
          </b:includable>
          <b:includable id="comments" var="post">
            <b:if cond="data:post.allowComments or (data:post.numberOfComments and data:post.numberOfComments &gt; 0)">
              <section class="comments-section" id="comments">
                <b:if cond="data:post.numberOfComments and data:post.numberOfComments &gt; 0">
                  <h3 class="comments-title">
                    <b:eval expr="data:post.numberOfComments"/> Comments
                  </h3>
                </b:if>
                <b:if cond="data:post.allowComments">
                  <b:include name="threadedComments" data="post"/>
                </b:if>
                <b:if cond="not data:post.allowComments and (data:post.numberOfComments and data:post.numberOfComments &gt; 0)">
                  <h3 class="comments-title">Comments are closed.</h3>
                </b:if>
              </section>
            </b:if>
          </b:includable>
          <b:includable id="threadedComments" var="post">
            <div class="comments-content">
              <b:if cond="data:post.comments">
                <b:loop values="data:post.comments" var="comment">
                  <div class="comment" expr:id="&quot;c&quot; + data:comment.id">
                    <b:if cond="data:comment.isDeleted">
                      <div class="comment-tombstone">This comment has been deleted.</div>
                    </b:if>
                    <b:if cond="not data:comment.isDeleted">
                      <b:eval expr="data:comment.body"/>
                      <div class="comment-meta">
                        <b:eval expr="data:comment.author"/> · 
                        <b:eval expr="data:comment.timestamp"/>
                      </div>
                    </b:if>
                  </div>
                </b:loop>
              </b:if>
            </div>
            <b:if cond="data:post.allowComments">
              <b:include name="threadedCommentForm" data="post"/>
            </b:if>
          </b:includable>
          <b:includable id="threadedCommentForm" var="post">
            <div class="comment-form">
              <p>Please leave a comment:</p><a expr:href="data:post.commentFormIframeSrc" id="comment-editor-src">Add Comment</a>
            </div>
          </b:includable>
          <b:includable id="status-message">
            <div class="empty-state">
              <b:if cond="data:view.isError">
                <h2>That page doesn't exist.</h2>
                <p>But you can search for something else:</p>
              </b:if>
              <b:if cond="data:view.isSearch and not data:view.isLabelSearch">
                <h2>Nothing matched your search.</h2>
                <p>We couldn't find anything matching &quot;<b:eval expr='data:view.search.query.escaped'/>&quot;.</p>
              </b:if>
              <b:if cond="data:view.isLabelSearch">
                <h2>Nothing filed under this label yet.</h2>
                <p>No posts are tagged with &quot;<b:eval expr='data:view.search.label.escaped'/>&quot;.</p>
              </b:if>
              <b:if cond="data:view.isArchive">
                <h2>No posts in this period.</h2>
                <p>
                  <b:eval expr="data:view.archive.rangeMessage"/>
                </p>
              </b:if>
              <b:if cond="not data:view.isError and not data:view.isSearch and not data:view.isArchive">
                <h2>No posts published yet.</h2>
                <p>Check back later.</p>
              </b:if>
            </div>
          </b:includable>
          <b:includable id="postPagination">
            <b:if cond="data:newerPageUrl or data:olderPageUrl">
              <div class="pagination">
                <b:if cond="data:newerPageUrl"><a class="newer-link" expr:href="data:newerPageUrl">Newer Posts</a></b:if>
                <b:if cond="data:olderPageUrl"><a class="older-link" expr:href="data:olderPageUrl">Older Posts</a></b:if>
              </div>
            </b:if>
          </b:includable>
          <b:includable id="inlineAd"/>
          <b:includable id="postJumpLink"/>
          <b:includable id="feedLinks"/>
          <b:includable id="feedLinksBody"/>
          <b:includable id="nextPageLink"/>
          <b:includable id="previousPageLink"/>
          <b:includable id="homePageLink"/>
          <b:includable id="postCommentsAndAd"/>
          <b:includable id="postCommentsLink"/>
          <b:includable id="postFooterAuthorProfile"/>
          <b:includable id="aboutPostAuthor"/>
          <b:includable id="commentPicker"/>
          <b:includable id="addComments"/>
          <b:includable id="commentAuthorAvatar"/>
          <b:includable id="commentDeleteIcon"/>
          <b:includable id="commentsTitle"/>
          <b:includable id="commentList"/>
          <b:includable id="commentItem"/>
          <b:includable id="commentForm"/>
          <b:includable id="commentFormIframeSrc"/>
          <b:includable id="threadedCommentJs"/>
        </b:widget>
      </b:section>
    </main>
    <b:if cond="data:view.isLayoutMode or data:widgets any (w =&gt; w.sectionId == &quot;cta&quot;)">
      <div class="cta-container">
        <b:section class="cta" id="cta" maxwidgets="1" name="Call to Action" showaddelement="no">
          <b:widget id="HTML2" locked="false" title="Call to Action" type="HTML" version="2" visible="true">
            <b:includable id="main">
              <b:if cond="data:content">
                <aside class="cta-box">
                  <b:eval expr="data:content"/>
                </aside>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </div>
    </b:if>
    <b:if cond="data:view.isLayoutMode or data:widgets any (w =&gt; w.sectionId == &quot;footer&quot;)">
      <footer class="footer-container" role="contentinfo">
        <b:section class="footer" id="footer" maxwidgets="3" name="Footer" showaddelement="yes">
          <b:widget id="HTML3" locked="false" title="Footer" type="HTML" version="2" visible="true">
            <b:includable id="main">
              <b:if cond="data:content">
                <div class="footer-content">
                  <b:eval expr="data:content"/>
                </div>
              </b:if>
            </b:includable>
          </b:widget>
        </b:section>
      </footer>
    </b:if>
    <script>(()=>{document.documentElement.classList.add("js");})();</script>
  </body>
</html>
