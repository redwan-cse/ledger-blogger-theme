{
  "name": "ledger-blogger-theme",
  "version": "0.0.0",
  "private": true,
  "description": "A Blogger Layouts V3 theme verified against Blogger-rendered HTML.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11"
  },
  "scripts": {
    "generate": "tsx tools/generate.ts",
    "watch": "tsx tools/watch.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:golden": "tsx tools/golden-check.ts",
    "golden:update": "tsx tools/golden-check.ts --update",
    "contract:check": "tsx tools/contract-check.ts",
    "typecheck": "tsc --noEmit",
    "build:controls": "tsx tools/build-controls.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "tsx tools/render-harness.ts",
    "harness:browser": "playwright test",
    "deploy:check": "tsx tools/deploy-check.ts",
    "seed:staging": "tsx tools/seed-staging.ts",
    "m0:empty-theme": "tsx tools/create-empty-theme.ts",
    "test:a11y": "playwright test tests/render/a11y.spec.ts --project=javascript",
    "test:lighthouse": "tsx tools/lighthouse-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "lighthouse": "^13.0.1",
    "pug": "^3.0.3",
    "sass": "^1.89.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
