b:section(class='header' id='header' maxwidgets='1' name='Header' showaddelement='yes')
  b:widget(id='Header2' locked='true' title='Blog Header' type='Header' version='2' visible='true')
    b:includable(id='main' var='this')
      b:if(cond='data:view.isHomepage')
        h1.site-title
          a(expr:href='data:blog.homepageUrl')
            b:eval(expr='data:title')/
        b:else/
        p.site-title
          a(expr:href='data:blog.homepageUrl')
            b:eval(expr='data:title')/
      b:if(cond='data:description')
        p.site-tagline
          b:eval(expr='data:description')/
