b:section(class='header' id='header' name='Header' showaddelement='false')
  b:widget(id='Header1' locked='true' title='Blog Header' type='Header' version='2' visible='true')
    b:widget-settings
      b:widget-setting(name='displayUrl')
      b:widget-setting(name='displayHeight') 0
      b:widget-setting(name='sectionWidth') -1
      b:widget-setting(name='useImage') false
      b:widget-setting(name='shrinkToFit') false
      b:widget-setting(name='imagePlacement') BEHIND
      b:widget-setting(name='displayWidth') 0
    b:includable(id='main' var='this')
      a.header-brand(expr:href='data:blog.homepageUrl' aria-label='Md Redwan Ahmed — Home')
        img.header-avatar(alt='Md Redwan Ahmed' height='40' loading='lazy' src='https://blogger.googleusercontent.com/img/a/AVvXsEid2pK6sS9Z_2jCm6SFeomZwfHDSq0li0pY6e8i_NNiuJkwHKqMqJ9gLw2qws2Xp42oCc5QGFvDw-PjbWF6CHaF7D-BShybE1d5A4OglhgVfsNPm0dg-1CRHkmrBZnAv8neHaTTb_hEzsaZZMgUP9mnTJqSAvtYtuzbOEKnsE2OJ1viJolqiQU7D532vxQ=s160' width='40')/
        div.header-brand-text
          b:include(cond='data:imagePlacement in {"REPLACE", "BEFORE_DESCRIPTION"}' name='image')/
          b:include(cond='data:imagePlacement not in {"REPLACE", "BEFORE_DESCRIPTION"}' name='title')/
          b:include(cond='data:imagePlacement != "REPLACE"' name='description')/
      div.header-actions
        button.theme-toggle(aria-label='Toggle color theme' type='button')
          svg.theme-icon-sun(aria-hidden='true' height='20' viewBox='0 0 24 24' width='20')
            path(d='M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z')
          svg.theme-icon-moon(aria-hidden='true' height='20' viewBox='0 0 24 24' width='20')
            path(d='M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z')
        button.drawer-toggle(aria-controls='mobile-drawer' aria-expanded='false' aria-label='Toggle navigation' type='button')
          svg(aria-hidden='true' height='20' viewBox='0 0 24 24' width='20')
            path(d='M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z')
      b:include(cond='data:imagePlacement == "BEHIND"' name='behindImageStyle')/
    b:includable(id='title')
      //- Stable two-line brand lockup matching Fast Cyber Defense.
      b:if(cond='not data:view.isSingleItem')
        h1.site-title Md Redwan Ahmed
      b:if(cond='data:view.isSingleItem')
        p.site-title Md Redwan Ahmed
    b:includable(id='description')
      p.site-tagline Cyber Security Professional
    b:includable(id='image')
      b:include(name='super.image')/
      b:include(cond='data:this.imagePlacement == "REPLACE"' name='title')/
    b:includable(id='behindImageStyle')
