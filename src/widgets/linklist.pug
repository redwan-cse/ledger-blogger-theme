b:section(class='navlinks' id='navlinks' name='Navigation' showaddelement='false')
  b:widget(id='LinkList1' locked='false' title='Navigation' type='LinkList' version='2' visible='true')
    b:includable(id='main')
      nav.site-nav(aria-label='Main Navigation')
        ul.nav-list
          b:if(cond='data:links')
            b:loop(values='data:links' var='link')
              b:if(cond='data:link.name != "Home" and data:link.target != data:blog.homepageUrl')
                li.nav-item
                  a.nav-link(expr:href='data:link.target')
                    b:eval(expr='data:link.name')/
          b:if(cond='not data:links')
            li.nav-item
              a.nav-link(expr:href='data:blog.canonicalHomepageUrl path "search"') All Posts
            li.nav-item
              a.nav-link(href='https://www.blogger.com/followers/follow/5972841034338492159' target='_blank' rel='noopener noreferrer' title='Follow on Google Blogger') Follow
            li.nav-item
              a.nav-link(href='https://redwan.work/' target='_blank' rel='noopener noreferrer') Portfolio
            li.nav-item
              a.nav-link(href='https://fastcyberdefense.com/' target='_blank' rel='noopener noreferrer') Fast Cyber Defense
            li.nav-item
              a.nav-link(href='https://cal.com/redwancse' target='_blank' rel='noopener noreferrer') Consultation
