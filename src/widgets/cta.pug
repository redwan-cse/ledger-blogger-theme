b:section(class='cta' id='cta' name='Call to Action' showaddelement='false')
  b:widget(id='HTML2' locked='false' title='Call to Action' type='HTML' version='2' visible='true')
    b:includable(id='main')
      b:if(cond='data:content')
        aside.cta-box
          b:eval(expr='data:content')/
      b:if(cond='not data:content')
        aside.cta-box
          div.cta-content
            div.cta-tag // SPECIALIZED ENGAGEMENTS
            div.cta-title Need a security audit, red team engagement, or another pair of eyes on your stack?
            p.cta-desc From Red Team operations and cloud penetration testing (AWS / GCP) to infrastructure hardening. Discuss your threat model with Md Redwan Ahmed.
          div.cta-actions
            a.cta-btn.cta-btn-primary(href='https://cal.com/redwancse' target='_blank' rel='noopener noreferrer')
              span Schedule Consultation ↗
            a.cta-btn.cta-btn-secondary(href='https://fastcyberdefense.com/' target='_blank' rel='noopener noreferrer')
              span Fast Cyber Defense ↗

