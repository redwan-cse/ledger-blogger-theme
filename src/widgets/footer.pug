b:section(class='footer' id='footer' name='Footer' showaddelement='yes')
  b:widget(id='HTML3' locked='false' title='Footer' type='HTML' version='2' visible='true')
    b:includable(id='main')
      b:if(cond='data:content')
        div.footer-content
          b:eval(expr='data:content')/
      b:if(cond='not data:content')
        div.footer-grid
          //- Column 1: Brand / Description
          div.footer-col.footer-col-brand
            h3.footer-heading
              b:eval(expr='data:blog.title')/
            p.footer-desc
              b:eval(expr='data:blog.description ?: "Cybersecurity research, vulnerability analysis, and security engineering publications."')/
          //- Column 2: Advisory & Publications
          div.footer-col.footer-col-nav
            h3.footer-heading Advisory &amp; Posts
            ul.footer-links-list
              li
                a(href='https://cal.com/redwancse' target='_blank' rel='noopener noreferrer') Book Consultation →
              li
                a(href='https://fastcyberdefense.com/' target='_blank' rel='noopener noreferrer') Fast Cyber Defense
              li
                a(expr:href='data:blog.homepageUrl path "search"') All Publications
              li
                a(expr:href='data:blog.homepageUrl path "feeds/posts/default"') RSS Feed
          //- Column 3: Ecosystem & Social
          div.footer-col.footer-col-connect
            h3.footer-heading Main Site &amp; Social
            ul.footer-links-list
              li
                a(href='https://redwan.work/' target='_blank' rel='noopener noreferrer') Main Portfolio (redwan.work)
              li
                a(href='https://orcid.org/0009-0001-9419-4760' target='_blank' rel='noopener noreferrer') ORCID (0009-0001-9419-4760)
              li
                a(href='https://github.com/redwan-cse' target='_blank' rel='noopener noreferrer') GitHub (@redwan-cse)
              li
                a(href='https://linkedin.com/in/redwancse' target='_blank' rel='noopener noreferrer') LinkedIn (/in/redwancse)
        div.footer-bottom
          div.footer-bottom-left
            p.footer-copyright
              | © 2026 
              b:eval(expr='data:blog.title')/
              |  · Cybersecurity Research &amp; Notes
          div.footer-bottom-right
            a.footer-back-to-top(href='#content' aria-label='Back to top') Back to top ↑

  b:widget(id='Attribution1' locked='true' title='' type='Attribution' version='2' visible='true')
    b:widget-settings
      b:widget-setting(name='copyright')
    b:includable(id='main' var='this')
      div.footer-attribution
        span.blogger
          a(expr:href='data:bloggerUrl' rel='nofollow')
            b:message(name='messages.poweredByBlogger')/
